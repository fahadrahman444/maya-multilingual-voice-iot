# ==========================================
# MAYA: Environment Configuration
# ==========================================

# Google Gemini API Key (for Empathetic Cognitive Brain & Tools)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (for ultra-fast multilingual Whisper STT ~300ms)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Language Mirroring Policy ("mirror", "always_bn", "always_en")
LANGUAGE_MODE=mirror

# Brain Provider Configuration
# Choose "gemini" (free, 1M tokens/min limit) or "groq" (sub-second ultra-low latency)
BRAIN_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b

# Server Host & Port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Siri-Grade Voice & Latency Controls
VOICE_PACE=1.0
VOICE_EXPRESSIVITY=medium
VAD_ENDPOINT_MS=450
BARGE_IN_ENABLED=True

# Edge-TTS Neural Voice Profile (Default: Soft / Alluring Female)
TTS_VOICE=bn-BD-NabanitaNeural
TTS_VOICE_BN=bn-BD-NabanitaNeural
TTS_VOICE_EN=en-US-AvaNeural
TTS_PITCH=-3Hz
TTS_RATE=-5%

# Audio Ingestion & VAD Settings
SAMPLE_RATE=16000
CHANNELS=1
VAD_SILENCE_SECONDS=1.65
