# ==========================================
# MAYA: Environment Configuration
# ==========================================

# Google Gemini API Key (for Empathetic Cognitive Brain & Tools)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (for ultra-fast Bangla Whisper STT ~300ms)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Server Host & Port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Edge-TTS Bengali Voice
# Options: bn-BD-PradeepNeural (Male) or bn-BD-NabanitaNeural (Female)
TTS_VOICE=bn-BD-NabanitaNeural

# Audio Ingestion Settings
SAMPLE_RATE=16000
CHANNELS=1
VAD_SILENCE_SECONDS=1.0
