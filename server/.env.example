# ==========================================
# MAYA: Environment Configuration (English Voice IoT)
# ==========================================

# Google Gemini API Key (for Empathetic Cognitive Brain & Tools)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (for ultra-fast English Whisper STT ~150-250ms)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Language Policy & Regional Locale
LANGUAGE_MODE=always_en
LOCALE=bd  # bd (Bangladesh) | us | uk | global

# Brain Provider Configuration
# Choose "gemini" (free, 1M tokens/min limit) or "groq" (sub-second ultra-low latency)
BRAIN_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=qwen/qwen3.8-27b

# Server Host & Port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Voice & Latency Controls
VOICE_PACE=1.0
VOICE_EXPRESSIVITY=medium
VAD_ENDPOINT_MS=1650
BARGE_IN_ENABLED=True

# Edge-TTS Neural Voice Profile (English)
TTS_VOICE=en-US-AvaNeural
TTS_VOICE_EN=en-US-AvaNeural
TTS_PITCH=-2Hz
TTS_RATE=+0%

# Audio Ingestion & VAD Settings
SAMPLE_RATE=16000
CHANNELS=1
VAD_SILENCE_SECONDS=1.65
